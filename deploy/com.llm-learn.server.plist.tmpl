<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.llm-learn.server</string>
  <key>ProgramArguments</key><array><string>@HOME@/.local/bin/llm-learn</string><string>-addr</string><string>127.0.0.1:8790</string><string>-data</string><string>@HOME@/.local/share/llm-learn</string><string>-owner</string><string>@OWNER@</string><string>-tailnet-addr</string><string>@TSIP@:8790</string><string>-sidecar</string><string>@SIDECAR@</string></array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>@HOME@</string><key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>@HOME@/.local/state/llm-learn/llm-learn.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/llm-learn/llm-learn.log</string>
</dict></plist>
